#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""QuickShot — 面板托盘快速截图工具（树莓派 OS / labwc + wf-panel-pi）

在屏幕右上角面板托盘显示一个相机图标：
  左键单击  → 立即全屏截图（保存到 ~/Pictures/Screenshots 并复制到剪贴板）
  右键菜单  → 全屏截图 / 区域截图… / 3 秒后全屏截图 / 打开截图文件夹 / 退出

实现说明：wf-panel-pi 的托盘插件支持 org.kde.StatusNotifierItem 协议。
本程序用 Gio 直接导出该接口（含原始像素图标 IconPixmap，避免主题缓存问题），
并用 com.canonical.dbusmenu 提供右键菜单，左键 Activate 即触发截图。
"""

import configparser
import datetime
import os
import shutil
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import GdkPixbuf, GLib, Gio, Gtk

SAVE_DIR = os.path.expanduser("~/Pictures/Screenshots")
CONFIG_DIR = os.path.expanduser("~/.config/quickshot")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.ini")

DEFAULT_CONFIG = """[quickshot]
# 截图完成后是否显示提示弹窗：true / false
# 修改保存后立即生效，无需重启程序
show_popup = true
"""


def ensure_config():
    """首次运行时生成默认配置文件，已有则保留用户修改。"""
    os.makedirs(CONFIG_DIR, exist_ok=True)
    if not os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "w", encoding="utf-8") as f:
                f.write(DEFAULT_CONFIG)
        except OSError:
            pass


def popups_enabled():
    """读取弹窗开关。每次调用都重新读取文件，改动立即生效；出错时默认开启。"""
    try:
        cp = configparser.ConfigParser()
        cp.read(CONFIG_FILE, encoding="utf-8")
        return cp.getboolean("quickshot", "show_popup", fallback=True)
    except Exception:
        return True


ICON_PNG = os.path.expanduser("~/.local/share/icons/hicolor/48x48/apps/quickshot.png")
ICON_SVG = os.path.expanduser("~/.local/share/icons/hicolor/scalable/apps/quickshot.svg")
ITEM_PATH = "/StatusNotifierItem"
MENU_PATH = "/StatusNotifierMenu"
WATCHER = "org.kde.StatusNotifierWatcher"
POPUP_MS = 4000

SNI_XML = """
<node>
  <interface name="org.kde.StatusNotifierItem">
    <property name="Category" type="s" access="read"/>
    <property name="Id" type="s" access="read"/>
    <property name="Title" type="s" access="read"/>
    <property name="Status" type="s" access="read"/>
    <property name="WindowId" type="u" access="read"/>
    <property name="IconName" type="s" access="read"/>
    <property name="IconPixmap" type="a(iiay)" access="read"/>
    <property name="AttentionIconName" type="s" access="read"/>
    <property name="AttentionIconPixmap" type="a(iiay)" access="read"/>
    <property name="ToolTip" type="(sa(iiay)ss)" access="read"/>
    <property name="Menu" type="o" access="read"/>
    <property name="ItemIsMenu" type="b" access="read"/>
    <method name="Activate">
      <arg name="x" type="i" direction="in"/>
      <arg name="y" type="i" direction="in"/>
    </method>
    <method name="SecondaryActivate">
      <arg name="x" type="i" direction="in"/>
      <arg name="y" type="i" direction="in"/>
    </method>
    <method name="Scroll">
      <arg name="delta" type="i" direction="in"/>
      <arg name="orientation" type="s" direction="in"/>
    </method>
    <signal name="NewTitle"/>
    <signal name="NewIcon"/>
    <signal name="NewAttentionIcon"/>
    <signal name="NewToolTip"/>
    <signal name="NewStatus"><arg name="status" type="s"/></signal>
  </interface>
</node>
"""

DBUSMENU_XML = """
<node>
  <interface name="com.canonical.dbusmenu">
    <property name="Version" type="u" access="read"/>
    <property name="TextDirection" type="s" access="read"/>
    <property name="Status" type="s" access="read"/>
    <property name="IconThemePath" type="as" access="read"/>
    <method name="GetLayout">
      <arg type="i" direction="in"/>
      <arg type="i" direction="in"/>
      <arg type="as" direction="in"/>
      <arg type="u" direction="out"/>
      <arg type="(ia{sv}av)" direction="out"/>
    </method>
    <method name="GetGroupProperties">
      <arg type="ai" direction="in"/>
      <arg type="as" direction="in"/>
      <arg type="a(ia{sv})" direction="out"/>
    </method>
    <method name="GetProperty">
      <arg type="i" direction="in"/>
      <arg type="s" direction="in"/>
      <arg type="v" direction="out"/>
    </method>
    <method name="AboutToShow">
      <arg type="i" direction="in"/>
      <arg type="b" direction="out"/>
    </method>
    <method name="Event">
      <arg type="i" direction="in"/>
      <arg type="s" direction="in"/>
      <arg type="v" direction="in"/>
      <arg type="u" direction="in"/>
    </method>
    <method name="EventGroup">
      <arg type="a(isvu)" direction="in"/>
      <arg type="ai" direction="out"/>
    </method>
    <signal name="LayoutUpdated">
      <arg type="u"/>
      <arg type="i"/>
    </signal>
    <signal name="ItemActivationRequested">
      <arg type="i"/>
      <arg type="u"/>
    </signal>
    <signal name="ItemsPropertiesUpdated">
      <arg type="a(ia{sv})"/>
      <arg type="a(ias)"/>
    </signal>
  </interface>
</node>
"""


def have(cmd):
    return shutil.which(cmd) is not None


def icon_pixmap(size=48):
    """把 PNG 图标转成 SNI 规定的 a(iiay) ARGB32 原始像素。"""
    pb = GdkPixbuf.Pixbuf.new_from_file_at_size(ICON_PNG, size, size)
    w, h = pb.get_width(), pb.get_height()
    n = pb.get_n_channels()
    rs = pb.get_rowstride()
    px = pb.get_pixels()
    out = bytearray(w * h * 4)
    for y in range(h):
        row, dst = y * rs, y * w * 4
        for x in range(w):
            o = row + x * n
            r, g, b = px[o], px[o + 1], px[o + 2]
            a = px[o + 3] if n == 4 else 255
            i = dst + x * 4
            out[i] = a
            out[i + 1] = r * a // 255
            out[i + 2] = g * a // 255
            out[i + 3] = b * a // 255
    return GLib.Variant("a(iiay)", [(w, h, bytes(out))])


class QuickShot:
    """托盘图标 + 截图逻辑 + 提示弹窗。"""

    # 菜单: (id, 标签, 动作)
    MENU_ITEMS = [
        (1, "全屏截图", "shot_full"),
        (2, "区域截图…", "shot_region"),
        (3, "3 秒后全屏截图", "shot_delay"),
        (4, "打开截图文件夹", "open_folder"),
        (5, "退出", "quit"),
    ]

    def __init__(self):
        ensure_config()
        self.revision = 1
        self._pixmap = icon_pixmap() if os.path.exists(ICON_PNG) else \
            GLib.Variant("a(iiay)", [])
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.sni_id = self.bus.register_object(
            ITEM_PATH, Gio.DBusNodeInfo.new_for_xml(SNI_XML).interfaces[0],
            self._sni_method, self._sni_prop, None)
        self.menu_id = self.bus.register_object(
            MENU_PATH, Gio.DBusNodeInfo.new_for_xml(DBUSMENU_XML).interfaces[0],
            self._menu_method, self._menu_prop, None)

        self._register_watcher(tries=15)
        # 尽早/稍后各广播一次菜单布局，避免面板刚建代理时错过信号
        self.emit_layout()
        for delay in (0.5, 2.0):
            GLib.timeout_add(int(delay * 1000), self.emit_layout)

    # ---------- 注册到面板 ----------

    def _register_watcher(self, tries):
        def try_register():
            try:
                self.bus.call_sync(
                    WATCHER, "/StatusNotifierWatcher", WATCHER,
                    "RegisterStatusNotifierItem",
                    GLib.Variant("(s)", (self.bus.get_unique_name(),)),
                    None, Gio.DBusCallFlags.NONE, 2000, None)
                return False  # 成功，停止重试
            except GLib.Error as e:
                if tries <= 1:
                    print("无法注册托盘图标：%s" % e.message, file=sys.stderr)
                    Gtk.main_quit()
                    return False
                self._register_watcher(tries - 1)
                return False
        if tries > 0:
            GLib.timeout_add_seconds(2 if tries < 15 else 0, try_register)

    # ---------- org.kde.StatusNotifierItem ----------

    def _sni_prop(self, conn, sender, path, iface, name):
        if name == "Category":
            return GLib.Variant("s", "ApplicationStatus")
        if name == "Id":
            return GLib.Variant("s", "quickshot")
        if name == "Title":
            return GLib.Variant("s", "快速截图")
        if name == "Status":
            return GLib.Variant("s", "Active")
        if name == "WindowId":
            return GLib.Variant("u", 0)
        if name == "IconName":
            return GLib.Variant("s", "quickshot")
        if name == "IconPixmap":
            return self._pixmap
        if name == "AttentionIconName":
            return GLib.Variant("s", "")
        if name == "AttentionIconPixmap":
            return GLib.Variant("a(iiay)", [])
        if name == "ToolTip":
            return GLib.Variant("(sa(iiay)ss)",
                                ("", [], "快速截图 QuickShot",
                                 "左键：全屏截图\n右键：更多选项"))
        if name == "Menu":
            return GLib.Variant("o", MENU_PATH)
        if name == "ItemIsMenu":
            return GLib.Variant("b", False)
        return None

    def _sni_method(self, conn, sender, path, iface, method, params, inv):
        if method == "Activate":
            # 左键单击 → 快速全屏截图
            self.shot_full()
            inv.return_value(None)
        elif method == "SecondaryActivate":
            self.shot_region()
            inv.return_value(None)
        elif method == "Scroll":
            inv.return_value(None)
        else:
            inv.return_error(Gio.DBusError.new_for_dbus_error(
                "org.freedesktop.DBus.Error.UnknownMethod", method))

    # ---------- com.canonical.dbusmenu ----------

    def _item_props(self, item_id):
        for i, label, _cb in self.MENU_ITEMS:
            if i == item_id:
                return {
                    "label": GLib.Variant("s", label),
                    "enabled": GLib.Variant("b", True),
                    "visible": GLib.Variant("b", True),
                    "type": GLib.Variant("s", "standard"),
                }
        return {}

    def _leaf(self, item_id):
        # dbusmenu 布局节点为 (ia{sv}av)：children 是"变体数组"，
        # 每个子项各自包一层 variant（与 libdbusmenu 参考服务端一致）。
        # 注意：children 传原生 list，元素是已构建的 Variant，交给构造器逐个包 v。
        return (item_id, self._item_props(item_id), [])

    def _menu_prop(self, conn, sender, path, iface, name):
        if name == "Version":
            return GLib.Variant("u", 3)
        if name == "TextDirection":
            return GLib.Variant("s", "ltr")
        if name == "Status":
            return GLib.Variant("s", "normal")
        if name == "IconThemePath":
            return GLib.Variant("as", [])
        return None

    def _menu_method(self, conn, sender, path, iface, method, params, inv):
        if method == "GetLayout":
            _parent, _depth, _props = params.unpack()
            root = (0, {}, [GLib.Variant("(ia{sv}av)", self._leaf(i))
                            for i, _l, _c in self.MENU_ITEMS])
            inv.return_value(GLib.Variant("(u(ia{sv}av))",
                                          (self.revision, root)))
        elif method == "GetGroupProperties":
            ids, _props = params.unpack()
            ids = ids or [i for i, _l, _c in self.MENU_ITEMS]
            inv.return_value(GLib.Variant(
                "(a(ia{sv}))", ([(i, self._item_props(i)) for i in ids],)))
        elif method == "GetProperty":
            item_id, prop = params.unpack()
            v = self._item_props(item_id).get(prop)
            inv.return_value(GLib.Variant("(v)", (
                v if v is not None else GLib.Variant("s", ""),)))
        elif method == "AboutToShow":
            inv.return_value(GLib.Variant("(b)", (False,)))
        elif method == "Event":
            item_id, event, _data, _ts = params.unpack()
            if event == "clicked":
                self._dispatch(item_id)
            inv.return_value(None)
        elif method == "EventGroup":
            events = params.unpack()[0]
            inv.return_value(GLib.Variant("(ai)", ([
                e[0] for e in events if e[1] == "clicked" and self._dispatch(e[0])],)))
        else:
            inv.return_error(Gio.DBusError.new_for_dbus_error(
                "org.freedesktop.DBus.Error.UnknownMethod", method))

    def _dispatch(self, item_id):
        for i, _label, cb in self.MENU_ITEMS:
            if i == item_id:
                getattr(self, cb)()
                return True
        return False

    def emit_layout(self):
        try:
            self.bus.emit_signal(
                None, MENU_PATH, "com.canonical.dbusmenu", "LayoutUpdated",
                GLib.Variant("(ui)", (self.revision, 0)))
        except GLib.Error:
            pass
        return False

    # ---------- 截图动作 ----------

    def new_path(self):
        os.makedirs(SAVE_DIR, exist_ok=True)
        stamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        return os.path.join(SAVE_DIR, "Screenshot_%s.png" % stamp)

    def _run_async(self, argv, on_done, input_text=None):
        """后台运行命令，完成后回调 (returncode, stdout)。不阻塞主循环。"""
        try:
            proc = subprocess.Popen(
                argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                stdin=subprocess.PIPE if input_text else subprocess.DEVNULL,
                text=True)
        except Exception as e:
            on_done(-1, "", str(e))
            return
        if input_text:
            try:
                proc.stdin.write(input_text)
            except Exception:
                pass
            try:
                proc.stdin.close()
            except Exception:
                pass
        GLib.child_watch_add(GLib.PRIORITY_DEFAULT, proc.pid,
                             lambda pid, rc: on_done(rc, proc.stdout.read(), ""))

    def shot_full(self, *_args):
        path = self.new_path()
        self._run_async(["grim", path], lambda rc, out, err:
                        self.finish_shot(rc == 0, path, err))

    def shot_region(self, *_args):
        if not have("slurp"):
            self.popup("未找到 slurp，无法进行区域选择", ok=False)
            return
        self._run_async(["slurp"], self._region_selected)

    def _region_selected(self, rc, out, err):
        geo = out.strip()
        if rc != 0 or not geo:
            return  # 用户按 Esc 取消
        path = self.new_path()
        self._run_async(["grim", "-g", geo, path], lambda grc, _o, gerr:
                        self.finish_shot(grc == 0, path, gerr))

    def shot_delay(self, *_args):
        path = self.new_path()
        if popups_enabled():
            self.popup("3 秒后开始全屏截图…")
        GLib.timeout_add_seconds(3, self._delayed_shot, path)

    def _delayed_shot(self, path):
        self._run_async(["grim", path], lambda rc, _o, err:
                        self.finish_shot(rc == 0, path, err))
        return False

    def finish_shot(self, ok, path, err):
        if ok:
            self.copy_to_clipboard(path)
            if popups_enabled():
                self.popup("截图已保存：\n%s" % path, path=path)
        else:
            # 出错提示不受开关影响，始终提醒
            self.popup("截图失败：%s" % (err or "未知错误"), ok=False)

    def copy_to_clipboard(self, path):
        if not have("wl-copy"):
            return
        try:
            with open(path, "rb") as f:
                subprocess.Popen(["wl-copy"], stdin=f,
                                 stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)
        except Exception:
            pass  # 剪贴板失败不影响保存

    def open_folder(self, *_args):
        try:
            subprocess.Popen(["pcmanfm", SAVE_DIR],
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
        except Exception:
            pass

    def quit(self, *_args):
        Gtk.main_quit()

    # ---------- 保存提示弹窗 ----------

    def popup(self, text, ok=True, path=None):
        win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        win.set_title("QuickShot")
        win.set_decorated(False)
        win.set_resizable(False)
        win.set_skip_taskbar_hint(True)
        win.set_keep_above(True)

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10,
                      border_width=14)
        if ok and os.path.exists(ICON_SVG):
            try:
                img = Gtk.Image.new_from_file(ICON_SVG)
                img.set_pixel_size(36)
                box.pack_start(img, False, False, 0)
            except Exception:
                pass

        label = Gtk.Label(label=text)
        label.set_line_wrap(True)
        label.set_xalign(0.0)
        box.pack_start(label, False, False, 0)

        if path:
            btn = Gtk.Button(label="打开文件夹")
            btn.connect("clicked", lambda b: (self.open_folder(), win.destroy()))
            box.pack_start(btn, False, False, 0)
        btn = Gtk.Button(label="×")
        btn.connect("clicked", lambda b: win.destroy())
        box.pack_start(btn, False, False, 0)

        win.add(box)
        win.show_all()
        GLib.timeout_add(POPUP_MS, self._popup_timeout, win)

    def _popup_timeout(self, win):
        if win.get_visible():
            win.destroy()
        return False


def main():
    # 单实例保护：已有时不再重复显示托盘图标
    Gio.bus_own_name(Gio.BusType.SESSION, "org.zcode.QuickShot",
                     Gio.BusNameOwnerFlags.NONE, None, None,
                     lambda *_: sys.exit(1))
    QuickShot()
    Gtk.main()


if __name__ == "__main__":
    main()
